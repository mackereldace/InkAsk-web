# Prefer configuring AI in the "API 与模板" settings UI; saving takes effect immediately.
# Optional fallback: copy to .env and enter credentials locally. Never commit .env.
# OPENAI_* is used only when no provider profiles are saved in the UI.
# Restart the local server after changing .env.
OPENAI_API_KEY=
# Required: a model on your account with text + image input and Responses support.
OPENAI_MODEL=
# Optional OpenAI-compatible Responses endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8787
